def makeUserID (forename, surname, year_of_birth):
  if len(forename) <3:
    while len(forename) < 3:
      forename += "x"
  if len(surname) <3:
    while len(surname) <3:
      surname += "x"
  
  userID = forename[0:3] + surname [0:3] + year_of_birth
  return userID

userID = makeUserID(forename, surname, year_of_birth)

import random
import string

def generate_password(length = 8):
  characters = string.ascii_letters + string.digits + string.punctuation
  password = ''.join(random.choice(characters) for i in range(length))
  return password
  
password = generate_password()

